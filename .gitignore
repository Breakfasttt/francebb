# Fichiers que git ne doit jamais enregistrer (générés automatiquement, locaux ou secrets).

# Bibliothèques installées par pnpm
node_modules/

# Résultats des tests (Playwright)
coverage/
test-results/
playwright-report/

# Fichiers générés par Next.js, Turborepo et TypeScript
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Secrets : chaque app a un .env local, seul le modèle .env.example est enregistré
.env*
!.env.example
*.pem
.vercel

# Bases de données locales (développement et tests)
*.db
*.db-journal
*.db-wal
*.db-shm

# Journaux et sauvegardes (peuvent contenir des données personnelles)
logs/
backups/
backup.sql

# Hub : identifiants du client de test, recréés par apps/hub/scripts/e2e-setup.mjs
.sso-client.json
# Hub : client Prisma généré par `pnpm db:generate` (le site, lui, versionne le sien)
/apps/hub/prisma/generated-client/

# Fichiers système et journaux d'erreurs des gestionnaires de paquets
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
