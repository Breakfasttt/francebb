# Fichiers que git ne doit jamais enregistrer (générés automatiquement, locaux ou secrets).

# Bibliothèques installées par pnpm
node_modules/

# Résultats des tests (Playwright)
coverage/
test-results/
playwright-report/

# Fichiers générés par Next.js, Turborepo et TypeScript
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Secrets : chaque app a un .env local, seul le modèle .env.example est enregistré
.env*
!.env.example
*.pem
.vercel

# Bases de données locales (développement et tests)
*.db
*.db-journal
*.db-wal
*.db-shm
# Sauvegardes de la production : données personnelles, jamais dans git (carte 219)
docs/backup-db/

# Journaux et sauvegardes (peuvent contenir des données personnelles)
logs/
backups/
backup.sql

# Hub : identifiants du client de test, recréés par apps/hub/scripts/e2e-setup.mjs
.sso-client.json
.sso-hooks.json
# Hub : identifiants et secret d'événements de l'application de test des tests d'API (apps/hub/scripts/api-test-setup.mjs)
.api-client.json
.api-hooks.json
.api-third-party.json
.api-third-party-pending.json
# Hub : dernier lien de connexion par email écrit pendant les tests (apps/hub/lib/mail.ts, HUB_DEV_MAIL_FILE)
.last-magic-link.json
# Hub : client Prisma généré par `pnpm db:generate` (le site, lui, versionne le sien)
/apps/hub/prisma/generated-client/
# Application BBScheme : client Prisma généré par `pnpm db:generate`, comme pour le hub (carte 179)
/apps/bbscheme/prisma/generated-client/
# Application BBQuizz : client Prisma généré par `pnpm db:generate`, comme pour BBScheme (carte 180)
/apps/bbquizz/prisma/generated-client/

# Fichiers système et journaux d'erreurs des gestionnaires de paquets
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Adresses des bases Postgres locales, écrites par scripts/local-postgres.mjs
.local-postgres.json

# Réglages locaux de l'outil de conception Impeccable (propres à chaque poste)
.impeccable/config.local.json

# Fichiers de travail d'Impeccable (maquettes, captures, questions, audits) : seuls les briefs de page
# (surfaces/) sont enregistrés, car ils fixent la direction de conception d'une page
**/.impeccable/*
!**/.impeccable/surfaces/
!.impeccable/config.json
!.impeccable/design.json

# Réglages personnels de Claude Code (permissions propres au poste), journaux et dossiers d'éditeurs
.claude/settings.local.json
*.log
.idea/
