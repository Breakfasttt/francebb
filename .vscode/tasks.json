{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Merge to Master",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/merge-to-master.ps1",
        "-message",
        "${input:commitMessage}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Message du commit",
      "default": "Auto-commit avant merge sur master"
    }
  ]
}
