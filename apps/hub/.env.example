# Hub d'identité BBFrance — copier en .env (dev local)
BETTER_AUTH_URL=http://localhost:4000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base Postgres du hub : en local, ne rien mettre (`pnpm db:start` écrit l'adresse dans .env.local) ; en production, l'adresse Neon
HUB_DATABASE_URL=
# Connexion par mot de passe : dev/test uniquement, jamais en production
HUB_DEV_PASSWORD_LOGIN=1
NEXT_PUBLIC_HUB_DEV_PASSWORD_LOGIN=1
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
