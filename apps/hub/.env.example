# Réglages du hub de connexion FranceBB (le « passeport Blood Bowl »).
# En local : copier ce fichier en `.env` (même dossier) et remplir les valeurs.
# En ligne : recopier les blocs 1 et 2 dans le projet Vercel du hub (Settings > Environment Variables), voir DEPLOY.md.
# Le fichier `.env` contient des secrets : il n'est jamais enregistré dans git.

# ============================================================================================================
# 1. OBLIGATOIRE EN LIGNE
# ============================================================================================================

# Adresse publique du hub, sans / final (en ligne : https://auth.<domaine>).
BETTER_AUTH_URL=http://localhost:4000

# Secret du hub : générer avec `openssl rand -base64 32`. Propre au hub (pas le même que le site).
# ATTENTION : ne jamais le changer une fois en ligne : il chiffre les secrets d'événements des applications
# (il faudrait alors relancer scripts/client-hooks.mjs pour chaque application et recopier leurs secrets).
BETTER_AUTH_SECRET=

# Base Postgres du hub : en local, ne rien mettre (`pnpm db:start` écrit l'adresse dans .env.local) ;
# en ligne, l'adresse Neon de la base du hub (une base séparée de celle du site).
HUB_DATABASE_URL=

# Connexion avec Discord et Google. Adresses de retour à déclarer chez Discord et Google :
#   en local : http://localhost:4000/api/auth/callback/discord et http://localhost:4000/api/auth/callback/google
#   en ligne : https://auth.<domaine>/api/auth/callback/discord et https://auth.<domaine>/api/auth/callback/google
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des liens de connexion par email (le même service SMTP que le site convient).
# En développement, sans SMTP_HOST, le lien s'affiche dans le terminal du hub. En ligne, sans SMTP_HOST, aucun lien ne part.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur des mails, avec une adresse du domaine déclaré chez le service SMTP.
EMAIL_FROM=

# Secret de la purge nocturne (/api/cron/daily, appelée par Vercel chaque nuit à 3 h) : `openssl rand -base64 32`.
# Inutile en local.
CRON_SECRET=

# ============================================================================================================
# 2. FACULTATIF
# ============================================================================================================

# Clé du service d'hébergement d'images ImgBB, pour le bouton « Envoyer une image » de l'avatar (la même clé que le site
# convient). Sans elle, le bouton n'est pas proposé : l'avatar se choisit par adresse ou avec le générateur.
IMGBB_API_KEY=

# Applications tierces : vide = refusées ; 1 = ouvertes. Quota de requêtes par heure et par application (1000 si vide).
HUB_THIRD_PARTY_APPS=
HUB_THIRD_PARTY_QUOTA=

# ============================================================================================================
# 3. DÉVELOPPEMENT SEULEMENT : NE JAMAIS METTRE SUR VERCEL
# ============================================================================================================

# Comptes de test avec mot de passe (connexion rapide en local). Le serveur les refuse de toute façon en production.
HUB_DEV_PASSWORD_LOGIN=1
NEXT_PUBLIC_HUB_DEV_PASSWORD_LOGIN=1
