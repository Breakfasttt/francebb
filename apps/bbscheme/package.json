{
  "name": "@bbfrance/bbscheme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "prisma generate && next build",
    "start": "next start -p 4100",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:start": "node ../../scripts/local-postgres.mjs start bbscheme",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@prisma/client-runtime-utils": "7.5.0",
    "gifshot": "0.4.5",
    "html2canvas": "1.4.1",
    "next": "16.2.0",
    "prisma": "7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
