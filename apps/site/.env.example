# Environment Variables Example for BBFrance

# Database
# For local SQLite: file:./dev.db
# For Turso (LibSQL): libsql://your-db-url.turso.io?authToken=your-token
DATABASE_URL="file:./dev.db"

# NextAuth Configuration (v5 / Auth.js)
# Run `openssl rand -base64 32` to generate a secret
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SuperAdmin list (comma separated emails)
SUPERADMIN_EMAILS="votre@email.com,admin@bbfrance.fr"

# OAuth Providers
DISCORD_CLIENT_ID="votre-id-discord"
DISCORD_CLIENT_SECRET="votre-secret-discord"
GOOGLE_CLIENT_ID="votre-id-google"
GOOGLE_CLIENT_SECRET="votre-secret-google"

# Email Service (SMTP - compatible avec Resend, Mailtrap, Brevo, etc.)
RESEND_API_KEY=""
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="votre-cle-api-resend"
EMAIL_FROM="noreply@votre-domaine.fr"

# Cryptography
# Key for forum/message encryption (must be 64 hex characters or 32 chars)
ENCRYPTION_KEY="votre-cle-de-64-caracteres-hexadecimaux"

# Public API Keys (Frontend)
NEXT_PUBLIC_IMGBB_API_KEY=""
ALLOWED_DEV_ORIGINS="localhost:3000,192.168.1.XX"
