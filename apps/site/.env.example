# Réglages du site BBFrance : copier ce fichier en `.env` (même dossier) et remplir les valeurs.
# Le fichier `.env` contient des secrets : il n'est jamais enregistré dans git.

# --- Base de données ---
# En local : un fichier SQLite. (Passage à Postgres prévu, voir docs/adr/0004.)
DATABASE_URL="file:./dev.db"

# --- Connexion des membres (Auth.js) ---
# Secret qui signe les sessions : générer avec `openssl rand -base64 32`
AUTH_SECRET=""
# Adresse du site (sans / final)
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Emails promus automatiquement super-administrateur à la connexion (séparés par des virgules)
SUPERADMIN_EMAILS=""

# Connexion avec Discord et Google : identifiants créés sur leurs portails développeurs (voir DEPLOY.md)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Hub de connexion unique : laisser AUTH_MODE vide (= connexion actuelle) tant que le hub n'est pas en ligne
AUTH_MODE=""
HUB_ISSUER=""
HUB_CLIENT_ID=""
HUB_CLIENT_SECRET=""

# --- Envoi de mails (lien de connexion par email, notifications) ---
# N'importe quel service SMTP : Resend, Mailtrap, Brevo…
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@votre-domaine.fr"

# --- Chiffrement des messages privés ---
# 64 caractères hexadécimaux : générer avec `openssl rand -hex 32`
ENCRYPTION_KEY=""

# --- Divers ---
# Clé du service d'hébergement d'images ImgBB (envoi d'images dans les messages)
NEXT_PUBLIC_IMGBB_API_KEY=""
# Adresses autorisées en développement (ex. pour tester depuis un téléphone : localhost:3000,192.168.1.42)
ALLOWED_DEV_ORIGINS="localhost:3000"
