# Réglages du site FranceBB.
# En local : copier ce fichier en `.env` (même dossier) et remplir les valeurs.
# En ligne : recopier les blocs 1 à 4 dans le projet Vercel du site (Settings > Environment Variables), voir DEPLOY.md.
# Le fichier `.env` contient des secrets : il n'est jamais enregistré dans git.

# ============================================================================================================
# 1. OBLIGATOIRE EN LIGNE
# ============================================================================================================

# Base de données Postgres.
# En local : ne rien mettre ici. `pnpm dev` (à la racine) démarre la base locale (sans Docker) et écrit son adresse
# dans `.env.local`, prioritaire sur ce fichier. En ligne : l'adresse Neon de la base du site (voir DEPLOY.md).
DATABASE_URL=""

# Secret qui signe les sessions : générer avec `openssl rand -base64 32`. Propre au site (pas le même que le hub).
AUTH_SECRET=""

# Adresse publique du site, sans / final (en ligne : https://www.<domaine>). Les deux valeurs sont identiques.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clé de chiffrement des messages privés : 64 caractères hexadécimaux, générer avec `openssl rand -hex 32`.
# ATTENTION : ne jamais la changer une fois le site en ligne, sinon tous les messages privés deviennent illisibles.
# La garder aussi dans un endroit sûr (gestionnaire de mots de passe).
ENCRYPTION_KEY=""

# Envoi des mails (notifications, gazette, annonces). N'importe quel service SMTP : Resend, Brevo, Mailtrap…
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Expéditeur des mails, avec une adresse du domaine déclaré chez le service SMTP.
EMAIL_FROM='"FranceBB" <noreply@votre-domaine.fr>'

# Adresse de contact affichée dans les mentions légales (demandes RGPD, signalements).
CONTACT_EMAIL="contact@votre-domaine.fr"

# Emails promus automatiquement super-administrateur à leur connexion (séparés par des virgules).
SUPERADMIN_EMAILS=""

# ============================================================================================================
# 2. CONNEXION PAR LE HUB (le « passeport Blood Bowl », apps/hub)
# ============================================================================================================
# AUTH_MODE="hub" : les boutons de connexion du site passent par le hub. Vide : connexion directe (bloc 3).

AUTH_MODE=""
# Adresse du hub suivie de /api/auth (en ligne : https://auth.<domaine>/api/auth ; en local : http://localhost:4000/api/auth)
HUB_ISSUER=""
# Identifiant et secret du site chez le hub : donnés par `node scripts/register-client.mjs` (dans apps/hub)
HUB_CLIENT_ID=""
HUB_CLIENT_SECRET=""
# Secret des événements envoyés par le hub (bannissement, suppression de compte, export) :
# donné par `node scripts/client-hooks.mjs` (dans apps/hub). Sans lui, ces événements sont refusés.
HUB_EVENTS_SECRET=""

# ============================================================================================================
# 3. CONNEXION DIRECTE, SANS HUB (secours si AUTH_MODE est vide)
# ============================================================================================================
# Applications créées sur les portails développeurs Discord et Google (voir DEPLOY.md, « Gérer le site en ligne »).
# Inutiles quand AUTH_MODE="hub" : Discord et Google sont alors réglés sur le hub.

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================================================================
# 4. FACULTATIF
# ============================================================================================================

# Clé du service d'hébergement d'images ImgBB (avatars, blasons, images des messages et des ressources).
# Sans elle, l'envoi d'images est désactivé. Secrète : lue seulement par le serveur (app/imageUploadActions.ts).
# Ne jamais lui ajouter le préfixe NEXT_PUBLIC_, qui l'écrirait dans le code envoyé au navigateur.
IMGBB_API_KEY=""

# Page Médias, onglet Twitch : application créée sur https://dev.twitch.tv/console (« Website Integration »).
# Sans ces deux clés, les directs sont détectés dans le navigateur, sans les dernières vidéos ni les clips.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Adresse de l'application BBScheme (apps/bbscheme), sans / final, qui range les schémas de la balise [bbscheme].
# Vide : les schémas des messages affichent « Schéma indisponible », sans gêner le reste du site.
BBSCHEME_URL=""

# ============================================================================================================
# 5. DÉVELOPPEMENT SEULEMENT (ne pas mettre sur Vercel)
# ============================================================================================================

# Adresses autorisées en développement (ex. pour tester depuis un téléphone : localhost:3000,192.168.1.42)
ALLOWED_DEV_ORIGINS="localhost:3000"
