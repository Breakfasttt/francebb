{
  "name": "@bbfrance/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-db.mjs && playwright test",
    "lighthouse": "node scripts/e2e-db.mjs && playwright test -c playwright.lighthouse.config.ts",
    "db:start": "node ../../scripts/local-postgres.mjs start site",
    "db:migrate": "prisma migrate dev",
    "db:setup": "npx tsx prisma/firstSetup.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.1",
    "@bbfrance/ui": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@prisma/client-runtime-utils": "7.5.0",
    "@types/leaflet": "1.9.21",
    "@types/nodemailer": "6.4.17",
    "date-fns": "4.1.0",
    "gifshot": "0.4.5",
    "html2canvas": "1.4.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "next": "16.2.0",
    "next-auth": "5.0.0-beta.30",
    "nodemailer": "7.0.13",
    "prisma": "7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@auth/core": "0.41.0",
    "@next/env": "16.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  }
}
