{
  "permissions": {
    "allow": [
      "Bash(pnpm kanban*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:ratchet*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint:ratchet*)",
      "Bash(node apps/site/scripts/debt-count.mjs)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-deps.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
