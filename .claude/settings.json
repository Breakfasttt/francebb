{
  "permissions": {
    "allow": [
      "Bash(pnpm kanban*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:ratchet*)",
      "Bash(pnpm check)",
      "Bash(corepack pnpm check)",
      "Bash(node apps/site/scripts/debt-count.mjs)",
      "Bash(npx impeccable detect*)"
    ],
    "deny": [
      "Bash(*prisma migrate reset*)",
      "Bash(*db push --force-reset*)",
      "Bash(*db push*--accept-data-loss*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.*.local)",
      "Write(**/.env.production)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-deps.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-deps.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  }
}
